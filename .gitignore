# Source project directories whose names resemble ignored file extensions.
# These exceptions must remain after the broad *.app and *.wad rules.
!src/WadForge.App/
!src/WadForge.App/**
!src/WadForge.Wad/
!src/WadForge.Wad/**
!src/TrenchBroom.Companion.App/
