# Re-ignore generated output inside the unignored source projects.
# The ** exceptions above would otherwise make these folders trackable.
/src/WadForge.App/bin/
/src/WadForge.App/obj/
/src/WadForge.Wad/bin/
/src/WadForge.Wad/obj/
