index 0000000..2a7a95a
--- /dev/null
+++ b/lib/TbMdlLib/src/WadForgeAliases.cpp
@@ -0,0 +1,672 @@
+/*
+ Copyright (C) 2026 Strissel Studios
+
+ This file is part of the WadForge-compatible TrenchBroom build.
+
+ TrenchBroom is free software: you can redistribute it and/or modify
+ it under the terms of the GNU General Public License as published by
+ the Free Software Foundation, either version 3 of the License, or
+ any later version.
+ */
+#include "mdl/WadForgeAliases.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+
+namespace tb::mdl
+{
+namespace
+{
+
+using AliasMap = std::unordered_map<std::string, std::string>;
+
+struct ParsedManifest
+{
+  std::optional<std::string> wadFileName;
+  AliasMap aliases;
+};
+
+std::string asciiLower(std::string value)
+{
+  std::ranges::transform(value, value.begin(), [](const unsigned char character) {
+    return static_cast<char>(std::tolower(character));
+  });
+
+  return value;
+}
+
+void appendUtf8(std::string& output, const std::uint32_t codePoint)
+{
+  if (codePoint <= 0x7Fu)
+  {
+    output.push_back(static_cast<char>(codePoint));
+  }
+  else if (codePoint <= 0x7FFu)
+  {
+    output.push_back(static_cast<char>(0xC0u | (codePoint >> 6u)));
+    output.push_back(static_cast<char>(0x80u | (codePoint & 0x3Fu)));
+  }
+  else if (codePoint <= 0xFFFFu)
+  {
+    output.push_back(static_cast<char>(0xE0u | (codePoint >> 12u)));
+    output.push_back(static_cast<char>(0x80u | ((codePoint >> 6u) & 0x3Fu)));
+    output.push_back(static_cast<char>(0x80u | (codePoint & 0x3Fu)));
+  }
+  else if (codePoint <= 0x10FFFFu)
+  {
+    output.push_back(static_cast<char>(0xF0u | (codePoint >> 18u)));
+    output.push_back(static_cast<char>(0x80u | ((codePoint >> 12u) & 0x3Fu)));
+    output.push_back(static_cast<char>(0x80u | ((codePoint >> 6u) & 0x3Fu)));
+    output.push_back(static_cast<char>(0x80u | (codePoint & 0x3Fu)));
+  }
+  else
+  {
+    throw std::runtime_error{"Invalid Unicode code point"};
+  }
+}
+
+class JsonReader
+{
+private:
+  std::string_view m_input;
+  std::size_t m_position = 0u;
+
+public:
+  explicit JsonReader(const std::string_view input)
+    : m_input{input}
+  {
+  }
+
+  ParsedManifest parseManifest()
+  {
+    auto manifest = ParsedManifest{};
+
+    expect('{');
+
+    if (consume('}'))
+    {
+      verifyEnd();
+      return manifest;
+    }
+
+    while (true)
+    {
+      const auto key = parseString();
+      expect(':');
+
+      if (key == "wadFileName" && nextTokenIs('"'))
+      {
+        manifest.wadFileName = parseString();
+      }
+      else if (key == "textures" && nextTokenIs('['))
+      {
+        parseTextures(manifest.aliases);
+      }
+      else
+      {
+        skipValue();
+      }
+
+      if (consume('}'))
+      {
+        break;
+      }
+
+      expect(',');
+    }
+
+    verifyEnd();
+    return manifest;
+  }
+
+private:
+  bool atEnd() const
+  {
+    return m_position >= m_input.size();
+  }
+
+  char readRaw()
+  {
+    if (atEnd())
+    {
+      throw std::runtime_error{"Unexpected end of JSON input"};
+    }
+
+    return m_input[m_position++];
+  }
+
+  char peekRaw() const
+  {
+    if (atEnd())
+    {
+      throw std::runtime_error{"Unexpected end of JSON input"};
+    }
+
+    return m_input[m_position];
+  }
+
+  void skipWhitespace()
+  {
+    while (
+      !atEnd()
+      && std::isspace(static_cast<unsigned char>(m_input[m_position])) != 0)
+    {
+      ++m_position;
+    }
+  }
+
+  bool nextTokenIs(const char expected)
+  {
+    skipWhitespace();
+    return !atEnd() && peekRaw() == expected;
+  }
+
+  bool consume(const char expected)
+  {
+    skipWhitespace();
+
+    if (atEnd() || peekRaw() != expected)
+    {
+      return false;
+    }
+
+    ++m_position;
+    return true;
+  }
+
+  void expect(const char expected)
+  {
+    skipWhitespace();
+
+    if (readRaw() != expected)
+    {
+      throw std::runtime_error{"Unexpected JSON token"};
+    }
+  }
+
+  void verifyEnd()
+  {
+    skipWhitespace();
+
+    if (!atEnd())
+    {
+      throw std::runtime_error{"Unexpected data after JSON document"};
+    }
+  }
+
+  static int hexValue(const char character)
+  {
+    if (character >= '0' && character <= '9')
+    {
+      return character - '0';
+    }
+
+    if (character >= 'a' && character <= 'f')
+    {
+      return 10 + character - 'a';
+    }
+
+    if (character >= 'A' && character <= 'F')
+    {
+      return 10 + character - 'A';
+    }
+
+    return -1;
+  }
+
+  std::uint32_t parseHexQuad()
+  {
+    auto value = std::uint32_t{0u};
+
+    for (auto index = 0; index < 4; ++index)
+    {
+      const auto digit = hexValue(readRaw());
+
+      if (digit < 0)
+      {
+        throw std::runtime_error{"Invalid JSON Unicode escape"};
+      }
+
+      value = (value << 4u) | static_cast<std::uint32_t>(digit);
+    }
+
+    return value;
+  }
+
+  std::string parseString()
+  {
+    skipWhitespace();
+
+    if (readRaw() != '"')
+    {
+      throw std::runtime_error{"Expected JSON string"};
+    }
+
+    auto result = std::string{};
+
+    while (true)
+    {
+      const auto character = readRaw();
+
+      if (character == '"')
+      {
+        break;
+      }
+
+      if (static_cast<unsigned char>(character) < 0x20u)
+      {
+        throw std::runtime_error{"Unescaped control character in JSON string"};
+      }
+
+      if (character != '\\')
+      {
+        result.push_back(character);
+        continue;
+      }
+
+      const auto escape = readRaw();
+
+      switch (escape)
+      {
+      case '"':
+        result.push_back('"');
+        break;
+      case '\\':
+        result.push_back('\\');
+        break;
+      case '/':
+        result.push_back('/');
+        break;
+      case 'b':
+        result.push_back('\b');
+        break;
+      case 'f':
+        result.push_back('\f');
+        break;
+      case 'n':
+        result.push_back('\n');
+        break;
+      case 'r':
+        result.push_back('\r');
+        break;
+      case 't':
+        result.push_back('\t');
+        break;
+      case 'u':
+      {
+        auto codePoint = parseHexQuad();
+
+        if (codePoint >= 0xD800u && codePoint <= 0xDBFFu)
+        {
+          if (readRaw() != '\\' || readRaw() != 'u')
+          {
+            throw std::runtime_error{"Missing low Unicode surrogate"};
+          }
+
+          const auto lowSurrogate = parseHexQuad();
+
+          if (lowSurrogate < 0xDC00u || lowSurrogate > 0xDFFFu)
+          {
+            throw std::runtime_error{"Invalid low Unicode surrogate"};
+          }
+
+          codePoint =
+            0x10000u
+            + ((codePoint - 0xD800u) << 10u)
+            + (lowSurrogate - 0xDC00u);
+        }
+        else if (codePoint >= 0xDC00u && codePoint <= 0xDFFFu)
+        {
+          throw std::runtime_error{"Unexpected low Unicode surrogate"};
+        }
+
+        appendUtf8(result, codePoint);
+        break;
+      }
+      default:
+        throw std::runtime_error{"Invalid JSON string escape"};
+      }
+    }
+
+    return result;
+  }
+
+  void parseTextures(AliasMap& aliases)
+  {
+    expect('[');
+
+    if (consume(']'))
+    {
+      return;
+    }
+
+    while (true)
+    {
+      if (nextTokenIs('{'))
+      {
+        parseTexture(aliases);
+      }
+      else
+      {
+        skipValue();
+      }
+
+      if (consume(']'))
+      {
+        break;
+      }
+
+      expect(',');
+    }
+  }
+
+  void parseTexture(AliasMap& aliases)
+  {
+    expect('{');
+
+    auto displayName = std::optional<std::string>{};
+    auto internalName = std::optional<std::string>{};
+
+    if (!consume('}'))
+    {
+      while (true)
+      {
+        const auto key = parseString();
+        expect(':');
+
+        if (key == "displayName" && nextTokenIs('"'))
+        {
+          displayName = parseString();
+        }
+        else if (key == "internalName" && nextTokenIs('"'))
+        {
+          internalName = parseString();
+        }
+        else
+        {
+          skipValue();
+        }
+
+        if (consume('}'))
+        {
+          break;
+        }
+
+        expect(',');
+      }
+    }
+
+    if (
+      displayName.has_value() && internalName.has_value()
+      && !displayName->empty() && !internalName->empty()
+      && internalName->size() <= 16u)
+    {
+      aliases[asciiLower(*internalName)] = std::move(*displayName);
+    }
+  }
+
+  void skipValue()
+  {
+    skipWhitespace();
+
+    const auto token = peekRaw();
+
+    switch (token)
+    {
+    case '"':
+      static_cast<void>(parseString());
+      return;
+    case '{':
+      skipObject();
+      return;
+    case '[':
+      skipArray();
+      return;
+    case 't':
+      skipLiteral("true");
+      return;
+    case 'f':
+      skipLiteral("false");
+      return;
+    case 'n':
+      skipLiteral("null");
+      return;
+    default:
+      skipNumber();
+      return;
+    }
+  }
+
+  void skipObject()
+  {
+    expect('{');
+
+    if (consume('}'))
+    {
+      return;
+    }
+
+    while (true)
+    {
+      static_cast<void>(parseString());
+      expect(':');
+      skipValue();
+
+      if (consume('}'))
+      {
+        break;
+      }
+
+      expect(',');
+    }
+  }
+
+  void skipArray()
+  {
+    expect('[');
+
+    if (consume(']'))
+    {
+      return;
+    }
+
+    while (true)
+    {
+      skipValue();
+
+      if (consume(']'))
+      {
+        break;
+      }
+
+      expect(',');
+    }
+  }
+
+  void skipLiteral(const std::string_view literal)
+  {
+    skipWhitespace();
+
+    if (
+      m_position + literal.size() > m_input.size()
+      || m_input.substr(m_position, literal.size()) != literal)
+    {
+      throw std::runtime_error{"Invalid JSON literal"};
+    }
+
+    m_position += literal.size();
+  }
+
+  void skipDigits()
+  {
+    const auto start = m_position;
+
+    while (
+      !atEnd()
+      && std::isdigit(static_cast<unsigned char>(m_input[m_position])) != 0)
+    {
+      ++m_position;
+    }
+
+    if (start == m_position)
+    {
+      throw std::runtime_error{"Invalid JSON number"};
+    }
+  }
+
+  void skipNumber()
+  {
+    skipWhitespace();
+
+    if (consume('-'))
+    {
+    }
+
+    if (atEnd())
+    {
+      throw std::runtime_error{"Invalid JSON number"};
+    }
+
+    if (peekRaw() == '0')
+    {
+      ++m_position;
+    }
+    else
+    {
+      skipDigits();
+    }
+
+    if (!atEnd() && peekRaw() == '.')
+    {
+      ++m_position;
+      skipDigits();
+    }
+
+    if (!atEnd() && (peekRaw() == 'e' || peekRaw() == 'E'))
+    {
+      ++m_position;
+
+      if (!atEnd() && (peekRaw() == '+' || peekRaw() == '-'))
+      {
+        ++m_position;
+      }
+
+      skipDigits();
+    }
+  }
+};
+
+AliasMap readAliasManifest(
+  const std::filesystem::path& manifestPath,
+  const std::filesystem::path& wadPath)
+{
+  auto stream = std::ifstream{manifestPath, std::ios::binary};
+
+  if (!stream)
+  {
+    return {};
+  }
+
+  const auto json = std::string{
+    std::istreambuf_iterator<char>{stream},
+    std::istreambuf_iterator<char>{}};
+
+  try
+  {
+    auto manifest = JsonReader{json}.parseManifest();
+
+    if (
+      !manifest.wadFileName.has_value()
+      || asciiLower(*manifest.wadFileName)
+           != asciiLower(wadPath.filename().string()))
+    {
+      return {};
+    }
+
+    return manifest.aliases;
+  }
+  catch (const std::exception&)
+  {
+    return {};
+  }
+}
+
+struct CacheEntry
+{
+  std::filesystem::file_time_type lastWriteTime;
+  AliasMap aliases;
+};
+
+std::mutex g_cacheMutex;
+std::unordered_map<std::string, CacheEntry> g_cache;
+
+std::string cacheKey(const std::filesystem::path& path)
+{
+  return asciiLower(path.lexically_normal().generic_string());
+}
+
+} // namespace
+
+std::optional<std::string> wadForgeDisplayName(
+  const std::filesystem::path& wadPath, const std::string& internalName)
+{
+  if (wadPath.empty() || internalName.empty())
+  {
+    return std::nullopt;
+  }
+
+  auto manifestPath = wadPath;
+  manifestPath += ".wadforge.json";
+
+  auto error = std::error_code{};
+  const auto lastWriteTime = std::filesystem::last_write_time(manifestPath, error);
+
+  if (error)
+  {
+    return std::nullopt;
+  }
+
+  const auto key = cacheKey(manifestPath);
+  const auto normalizedInternalName = asciiLower(internalName);
+
+  auto lock = std::lock_guard<std::mutex>{g_cacheMutex};
+  auto cacheIt = g_cache.find(key);
+
+  if (
+    cacheIt == g_cache.end()
+    || cacheIt->second.lastWriteTime != lastWriteTime)
+  {
+    auto aliases = readAliasManifest(manifestPath, wadPath);
+
+    cacheIt = g_cache
+                .insert_or_assign(
+                  key,
+                  CacheEntry{
+                    lastWriteTime,
+                    std::move(aliases),
+                  })
+                .first;
+  }
+
+  const auto aliasIt = cacheIt->second.aliases.find(normalizedInternalName);
+
+  if (aliasIt == cacheIt->second.aliases.end())
+  {
+    return std::nullopt;
+  }
+
+  return aliasIt->second;
+}
+
+} // namespace tb::mdl
