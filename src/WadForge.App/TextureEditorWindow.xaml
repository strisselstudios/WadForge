<Window x:Class="WadForge.App.TextureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WadForge Texture Editor"
        Width="1240"
        Height="800"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#12151A"
        Foreground="#FFFFFF"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1D2229" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#343C47" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BEC6D1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D7A43A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#15191F" />
            <Setter Property="BorderBrush" Value="#56616E" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#8A6827" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#303842" />
            <Setter Property="BorderBrush" Value="#56616E" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Background" Value="#946A18" />
            <Setter Property="BorderBrush" Value="#D7A43A" />
        </Style>

        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,18,18"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,18,18"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#8C8C8C">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,18,18" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#B3B3B3">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,9,9" />
                                <RectangleGeometry Rect="9,9,9,9" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="30"
                           FontWeight="Bold"
                           Text="Texture Editor" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"
                           Text="Open or drag in a WAD, preview its textures, rename them, and repair indexed mask backgrounds." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource DarkButtonStyle}"
                        Click="OpenWad_Click"
                        Content="Open WAD" />
                <StackPanel x:Name="PalettePanel"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="Palette" />
                    <ComboBox x:Name="PaletteComboBox"
                              Width="180"
                              Foreground="#FFFFFF"
                              Background="#303842"
                              BorderBrush="#56616E"
                              Padding="8,5"
                              SelectionChanged="PaletteComboBox_SelectionChanged"
                              ToolTip="Palette used for WAD2 texture previews">
                        <ComboBoxItem Tag="quake"
                                      Foreground="#FFFFFF"
                                      Background="#303842"
                                      Content="Quake (default)" />
                    </ComboBox>
                </StackPanel>
                <Button x:Name="AddPaletteButton"
                        Style="{StaticResource DarkButtonStyle}"
                        Click="AddPalette_Click"
                        Content="Add Palette..." />
                <Button x:Name="SaveCopyButton"
                        Style="{StaticResource DarkButtonStyle}"
                        Click="SaveCopy_Click"
                        Content="Save Copy..."
                        IsEnabled="False" />
                <Button x:Name="SaveInPlaceButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0"
                        Click="SaveInPlace_Click"
                        Content="Save In Place"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="WadPathText"
                               FontWeight="SemiBold"
                               Text="Drop a WAD here or choose Open WAD." />
                    <TextBlock x:Name="WadInfoText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="No WAD loaded." />
                </StackPanel>

                <TextBlock x:Name="PendingText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           Text="0 staged edits" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBox x:Name="SearchTextBox"
                                 TextChanged="SearchTextBox_TextChanged"
                                 ToolTip="Search texture names" />
                        <TextBlock x:Name="SelectionSummaryText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Text="0 selected - Ctrl/Shift-click for batch actions" />
                        <WrapPanel Margin="0,5,0,0">
                            <Button x:Name="BatchAddMaskButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="7,4"
                                    IsEnabled="False"
                                    Click="BatchAddMask_Click"
                                    Content="Add &#123;" />
                            <Button x:Name="BatchRemoveMaskButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Margin="0"
                                    Padding="7,4"
                                    IsEnabled="False"
                                    Click="BatchRemoveMask_Click"
                                    Content="Remove &#123;" />
                        </WrapPanel>
                    </StackPanel>

                    <ListBox x:Name="TextureList"
                             Grid.Row="2"
                             Background="#15191F"
                             BorderBrush="#343C47"
                             Foreground="#FFFFFF"
                             SelectionMode="Extended"
                              SelectionChanged="TextureList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding InternalName}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding StatusText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding DimensionsText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#171B21"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="8"
                            Background="#1D2229"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <WrapPanel x:Name="PixelToolsPanel"
                                   VerticalAlignment="Center">
                            <Button x:Name="PencilToolButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="PencilTool_Click"
                                    Content="Pencil" />
                            <Button x:Name="FillToolButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="FillTool_Click"
                                    Content="Fill" />
                            <Button x:Name="EyedropperToolButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="EyedropperTool_Click"
                                    Content="Pick" />
                            <Button x:Name="TransparencyToolButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="TransparencyTool_Click"
                                    Content="Transparency" />
                            <TextBlock Margin="4,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Brush" />
                            <ComboBox x:Name="BrushSizeComboBox"
                                      Width="58"
                                      Margin="0,0,8,0"
                                      Foreground="#FFFFFF"
                                      Background="#303842"
                                      BorderBrush="#56616E"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="1" Content="1" />
                                <ComboBoxItem Tag="3" Content="3" />
                                <ComboBoxItem Tag="5" Content="5" />
                            </ComboBox>
                            <Button x:Name="UndoPixelButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    IsEnabled="False"
                                    Click="UndoPixel_Click"
                                    Content="Undo" />
                            <Button x:Name="RedoPixelButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Margin="0"
                                    IsEnabled="False"
                                    Click="RedoPixel_Click"
                                    Content="Redo" />
                            <TextBlock Margin="10,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Zoom" />
                            <Button x:Name="ZoomOutButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="ZoomOut_Click"
                                    Content="-" />
                            <Button x:Name="ZoomFitButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="ZoomFit_Click"
                                    Content="Fit" />
                            <Button x:Name="ZoomActualButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="ZoomActual_Click"
                                    Content="1:1" />
                            <Button x:Name="ZoomInButton"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="8,5"
                                    Click="ZoomIn_Click"
                                    Content="+" />
                            <TextBlock x:Name="ZoomText"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       MinWidth="62"
                                       Text="Fit" />                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource CheckerBrush}">
                        <ScrollViewer x:Name="PreviewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      PanningMode="Both"
                                      PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel">
                            <Grid Margin="18">
                                <Image x:Name="PreviewImage"
                                       Stretch="None"
                                       Cursor="Cross"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                       MouseMove="PreviewImage_MouseMove"
                                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="PreviewScaleTransform"
                                                        ScaleX="1"
                                                        ScaleY="1" />
                                    </Image.LayoutTransform>
                                </Image>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Margin="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#2A2E35"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Text="Select a texture to preview it." />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>            <Border Grid.Column="4"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Selected texture" />

                        <TextBlock Margin="0,14,0,5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Internal name" />
                        <TextBox x:Name="TextureNameTextBox"
                                 TextChanged="EditorField_Changed"
                                 IsEnabled="False" />

                        <CheckBox x:Name="MaskedCheckBox"
                                  Margin="0,14,0,0"
                                  Foreground="#FFFFFF"
                                  Checked="MaskedCheckBox_Changed"
                                  Unchecked="MaskedCheckBox_Changed"
                                  Content="Masked texture ({ prefix)"
                                  IsEnabled="False" />

                        <CheckBox x:Name="RemapEdgeCheckBox"
                                  Margin="0,10,0,0"
                                  Foreground="#FFFFFF"
                                  Checked="EditorField_Changed"
                                  Unchecked="EditorField_Changed"
                                  Content="Remap detected edge index to 255"
                                  IsEnabled="False" />

                        <CheckBox x:Name="PreviewRepairCheckBox"
                                  Margin="0,10,0,0"
                                  Foreground="#FFFFFF"
                                  Checked="PreviewRepairCheckBox_Changed"
                                  Unchecked="PreviewRepairCheckBox_Changed"
                                  Content="Preview staged transparency"
                                  IsChecked="True"
                                  IsEnabled="False" />

                        <TextBlock x:Name="TextureDetailsText"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Select a texture for details." />

                        <TextBlock Margin="0,16,0,5"
                                   FontWeight="SemiBold"
                                   Text="Pixel color" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="SelectedPaletteSwatch"
                                    Width="30"
                                    Height="22"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1"
                                    Background="#000000" />
                            <TextBlock x:Name="SelectedPaletteIndexText"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Index 0" />
                        </StackPanel>
                        <UniformGrid x:Name="PaletteGrid"
                                     Margin="0,8,0,0"
                                     Columns="16"
                                     Rows="16"
                                     MinHeight="240" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="Pixel tools affect only the active preview texture. Choose index 255 or Transparency to paint explicit mask pixels." />                        <Border Margin="0,16,0,16"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0" />

                        <Button x:Name="StageEditButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0"
                                Click="StageEdit_Click"
                                Content="Stage Texture Changes"
                                IsEnabled="False" />

                        <Button x:Name="UnstageEditButton"
                                Style="{StaticResource DarkButtonStyle}"
                                Margin="0,8,0,0"
                                Click="UnstageEdit_Click"
                                Content="Remove Staged Edit"
                                IsEnabled="False" />

                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Tip: if a texture already uses palette index 255 for its pink/blue background, checking Masked is enough. If the intended background uses another index, also enable the remap option after visually confirming the preview." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="6"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Ready." />
    </Grid>
</Window>
