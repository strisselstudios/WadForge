<Window x:Class="WadForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WadForge by Strissel" Icon="Assets/Wad-Forge.ico" Width="1280" Height="840" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#12151A" Foreground="#FFFFFF" AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragEnter" Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1D2229" />

        <SolidColorBrush x:Key="PanelBorderBrush" Color="#343C47" />

        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#15191F" />

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BEC6D1" />

        <SolidColorBrush x:Key="AccentBrush" Color="#D7A43A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="Background" Value="#15191F" />

            <Setter Property="BorderBrush" Value="#56616E" />

            <Setter Property="CaretBrush" Value="#FFFFFF" />

            <Setter Property="SelectionBrush" Value="#8A6827" />

            <Setter Property="Padding" Value="9,7" />

            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="Background" Value="#303842" />

            <Setter Property="BorderBrush" Value="#56616E" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="15,8" />

            <Setter Property="MinHeight" Value="38" />

            <Setter Property="Margin" Value="0,0,10,0" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414B58" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#232A32" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#20252C" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#343B44" />

                                <Setter Property="Foreground" Value="#727B87" />

                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Background" Value="#946A18" />

            <Setter Property="BorderBrush" Value="#D7A43A" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#15191F" />

            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="BorderBrush" Value="#343C47" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="GridLinesVisibility" Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush" Value="#303741" />

            <Setter Property="RowBackground" Value="#171C22" />

            <Setter Property="AlternatingRowBackground" Value="#1C222A" />

            <Setter Property="SelectionMode" Value="Extended" />

            <Setter Property="SelectionUnit" Value="FullRow" />

            <Setter Property="CanUserAddRows" Value="False" />

            <Setter Property="CanUserDeleteRows" Value="False" />

            <Setter Property="CanUserResizeRows" Value="False" />

            <Setter Property="AutoGenerateColumns" Value="False" />

            <Setter Property="HeadersVisibility" Value="Column" />

            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2B323B" />

            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="BorderBrush" Value="#424B57" />

            <Setter Property="BorderThickness" Value="0,0,1,1" />

            <Setter Property="Padding" Value="10,9" />

            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="MinHeight" Value="34" />

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#55431E" />

                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="9,5" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#55431E" />

                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="34" FontWeight="Bold" Text="WadForge by Strissel" />

                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" Text="Batch texture conversion and WAD archive extraction." />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource DarkButtonStyle}"
                        Margin="0"
                        Click="OpenTextureEditor_Click"
                        Content="Texture Editor" />



            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="16" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Conversion direction" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <RadioButton x:Name="ImagesToWadRadio" GroupName="ConversionDirection" IsChecked="True" Checked="ConversionDirection_Checked" Content="Images to WAD" />

                        <RadioButton x:Name="WadToPngRadio" GroupName="ConversionDirection" Checked="ConversionDirection_Checked" Content="WAD to PNG" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="WadFormatPanel" Grid.Column="2">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="WAD output format" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <RadioButton x:Name="Wad2Radio" GroupName="WadOutputFormat" IsChecked="True" Checked="WadFormat_Checked" Content="WAD2" />

                        <RadioButton x:Name="Wad3Radio" GroupName="WadOutputFormat" Margin="0" Checked="WadFormat_Checked" Content="WAD3" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ColorProcessingPanel" Grid.Column="4">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Color processing" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox x:Name="DitheringCheckBox" IsChecked="True" Content="Dithering" />

                        <CheckBox x:Name="TransparencyCheckBox" Margin="0" IsChecked="True" Content="Preserve transparency" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="12" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddImagesButton" Style="{StaticResource DarkButtonStyle}" Click="AddImages_Click" Content="Add Images" />

                    <Button x:Name="AddWadFilesButton" Style="{StaticResource DarkButtonStyle}" Click="AddWadFiles_Click" Content="Add WAD Files" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Files and folders can be dragged directly into the window." />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RemoveSelectedButton" Style="{StaticResource DarkButtonStyle}" IsEnabled="False" Click="RemoveSelected_Click" Content="Remove Selected" />

                    <Button x:Name="ClearQueueButton" Style="{StaticResource DarkButtonStyle}" Margin="0" IsEnabled="False" Click="ClearQueue_Click" Content="Clear Queue" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <DataGrid x:Name="QueueGrid" ItemsSource="{Binding QueueItems}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="QueueGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="225" Header="Source file" Binding="{Binding SourceFileName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}">
                                    <Setter Property="ToolTip" Value="{Binding SourcePath}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="80" Header="Type" Binding="{Binding ItemType}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="FullDisplayNameColumn" Width="240" Header="Full display name" Binding="{Binding DisplayName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}">
                                    <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="InternalNameColumn" Width="150" Header="WAD-safe name" Binding="{Binding InternalName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}">
                                    <Setter Property="FontFamily" Value="Consolas" />

                                    <Setter Property="Foreground" Value="#F1C86B" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="*" MinWidth="260" Header="Details" Binding="{Binding Details}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}">
                                    <Setter Property="Foreground" Value="#CBD3DD" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="100" Header="Status" Binding="{Binding Status}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextStyle}">
                                    <Setter Property="Foreground" Value="#8ED69B" />

                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyQueuePanel" Margin="26" Background="#12161B" BorderBrush="#4A5563" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="Drop files or folders here" />

                        <TextBlock x:Name="DropInstructionText" Margin="0,9,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Text="PNG, JPG, JPEG, BMP, GIF and TIFF images are accepted." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="8" Padding="15" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="OutputWadNamePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="OutputWadNameLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="Output WAD name" />

                    <TextBox x:Name="OutputWadNameTextBox" Grid.Column="1" Text="textures.wad" TextChanged="OutputWadName_TextChanged" />

                    <TextBlock x:Name="OutputWadNameHelpText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Existing files are never overwritten. A numbered suffix is added automatically." />

                    <TextBlock x:Name="ExtractionOutputFolderHelpText" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" Text="Choose the folder where WadForge will create one PNG output folder for each WAD." />

                    <Button x:Name="ChooseOutputFolderButton" Grid.Column="4" Style="{StaticResource DarkButtonStyle}" Margin="12,0,0,0" Click="ChooseOutputFolder_Click" Content="Choose Output Folder" />
                </Grid>

                <Grid x:Name="Wad2PalettePanel" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="WAD2 palette" />

                    <TextBlock x:Name="Wad2PaletteText" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="No palette selected. WAD2 requires a 768-byte palette." />

                    <Button Grid.Column="2" Style="{StaticResource DarkButtonStyle}" Margin="0" Click="ChooseWad2Palette_Click" Content="Select Palette" />
                </Grid>

                <ProgressBar x:Name="ConversionProgressBar" Grid.Row="4" Height="8" Minimum="0" Maximum="100" Value="0" />

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="Output folder: " />

                            <TextBlock x:Name="OutputFolderText" Foreground="{StaticResource SecondaryTextBrush}" Text="No output folder selected" />
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock x:Name="QueueCountText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="0 items" />

                            <TextBlock Margin="16,0,0,0" Foreground="#69727E" Text="|" />

                            <TextBlock x:Name="StatusText" Margin="16,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="Ready for files." />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="ConvertButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" MinWidth="150" IsEnabled="False" Click="ConvertBatch_Click" Content="Convert Batch" />
                </Grid>
            </Grid>
        </Border>    </Grid>
</Window>
