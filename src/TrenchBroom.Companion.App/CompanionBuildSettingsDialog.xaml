<Window x:Class="TrenchBroom.Companion.App.CompanionBuildSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compile Settings"
        Width="900"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0D131B"
        Foreground="#FFFFFF">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151E29" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#344356" />
        <SolidColorBrush x:Key="RowBorderBrush" Color="#2C394A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D8E1EC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AEBBCD" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD27A" />

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#101923" />
            <Setter Property="BorderBrush" Value="#60748D" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#101923" />
            <Setter Property="BorderBrush" Value="#60748D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" />
                            <ContentPresenter Margin="8,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="#E8EEF6"
                                                      Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,3,0,0"
                                        Background="#182330"
                                        BorderBrush="#60748D"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#7C93AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#18212C" />
                                <Setter Property="Foreground" Value="#9AA8BA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#182330" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CompactTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#1C2937" />
            <Setter Property="BorderBrush" Value="#46586E" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,2,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#286FC5" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#7CB5FF" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#29405A" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#327FD8" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#243244" />
            <Setter Property="BorderBrush" Value="#60748D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#286FC5" />
            <Setter Property="BorderBrush" Value="#7CB5FF" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">
            <TextBlock FontSize="23"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Text="Compile Settings" />
            <TextBlock x:Name="ContextText"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="#0D131B"
                    BorderBrush="#46586E"
                    Foreground="#FFFFFF">
            <TabItem Header="Common"
                     Style="{StaticResource CompactTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CommonOptionsPanel"
                                Margin="10" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="QBSP"
                     Style="{StaticResource CompactTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="QbspOptionsPanel"
                                Margin="10" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="VIS"
                     Style="{StaticResource CompactTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <Border Margin="0,0,0,8"
                                Padding="9"
                                Background="#151E29"
                                BorderBrush="#46586E"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="VIS is currently not available for DUSK." />
                        </Border>
                        <StackPanel x:Name="VisOptionsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LIGHT"
                     Style="{StaticResource CompactTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LightOptionsPanel"
                                Margin="10" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LIGHT Globals"
                     Style="{StaticResource CompactTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LightGlobalOptionsPanel"
                                Margin="10" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="InfoPanel"
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Visibility="Collapsed"
                Background="#151E29"
                BorderBrush="#536980"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="InfoTitleText"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoDescriptionText"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoAvailabilityText"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Width="30"
                        Height="30"
                        VerticalAlignment="Top"
                        Foreground="#FFFFFF"
                        Background="#243244"
                        BorderBrush="#60748D"
                        Content="×"
                        ToolTip="Close information"
                        Click="CloseInfo_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource DarkButtonStyle}"
                    Content="Restore Defaults"
                    Click="RestoreDefaults_Click" />

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DarkButtonStyle}"
                    Content="EricW Reference"
                    Click="Documentation_Click" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button Margin="0,0,9,0"
                        Style="{StaticResource DarkButtonStyle}"
                        Content="Cancel"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="Save Compile Settings"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
