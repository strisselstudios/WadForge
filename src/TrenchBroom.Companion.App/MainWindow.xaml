<Window x:Class="TrenchBroom.Companion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrenchBroom Companion by Strissel"
        Icon="Assets/TrenchBroom-Companion.ico"
        Width="1280"
        Height="820"
        MinWidth="1280"
        MinHeight="820"
        MaxWidth="1280"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0E1218"
        Foreground="#FFFFFF"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1218" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111720" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#171E27" />
        <SolidColorBrush x:Key="PanelBackgroundRaisedBrush" Color="#1C2530" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3745" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB9C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#748193" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5EA2FF" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#244A75" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6FD19B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#111820" />
            <Setter Property="BorderBrush" Value="#364455" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#315F94" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#151D26" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24476D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D3652" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A8797" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MapChoiceTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="#F4F7FB"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DisplayName}" />
        </DataTemplate>
        <DataTemplate x:Key="RecentProjectChoiceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="#F4F7FB"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,20,0"
                               Text="{Binding DirectoryPath}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DirectoryPath}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding GameDisplayName}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="DarkContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="#151D26" />
            <Setter Property="Foreground"
                    Value="#F4F7FB" />
            <Setter Property="BorderBrush"
                    Value="#354454" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="4" />
            <Setter Property="MinWidth"
                    Value="220" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="#F4F7FB" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="12,9" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="#24476D" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="#758294" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#151D26" />
            <Setter Property="BorderBrush" Value="#3A4859" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" />

                            <ContentPresenter Margin="10,0,36,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        Margin="0,5,0,5"
                                                        BorderBrush="#334152"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 8 0 L 4 5 Z"
                                                          Fill="#B8C3D0"
                                                          Stretch="Fill" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="#151D26"
                                        BorderBrush="#3A4859"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5A7190" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5EA2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#171D25" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#28313C" />
                                <Setter Property="Foreground" Value="#8290A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#26313E" />
            <Setter Property="BorderBrush" Value="#3A4859" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#344253" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1F2934" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#171D25" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#28313C" />
                                <Setter Property="Foreground" Value="#687586" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2768AE" />
            <Setter Property="BorderBrush" Value="#5EA2FF" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB9C7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SidebarBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarBorder" Property="Background" Value="#1A2430" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4E5967" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1D3652" />
            <Setter Property="BorderBrush" Value="#315F94" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="ProjectMapListStyle"
               TargetType="ListBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ProjectMapListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="MapRowBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MapRowBorder" Property="Background" Value="#182432" />
                                <Setter TargetName="MapRowBorder" Property="BorderBrush" Value="#33475D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="MapRowBorder" Property="Background" Value="#1D3652" />
                                <Setter TargetName="MapRowBorder" Property="BorderBrush" Value="#5EA2FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718094" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2B3745" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#26313D" />
            <Setter Property="RowBackground" Value="#131A22" />
            <Setter Property="AlternatingRowBackground" Value="#171F29" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202A35" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#344252" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24476D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24476D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top application bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111720" BorderBrush="#273240" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#2768AE" CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="TC" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold" Text="TrenchBroom Companion" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="by Strissel" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ShellContextText" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="No project open" />
                    <Border x:Name="ProjectReadinessBorder" Padding="10,5" Background="#17261F" BorderBrush="#315D46" BorderThickness="1" CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ProjectReadinessDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                            <TextBlock x:Name="ProjectReadinessText" Foreground="#BDEED2" FontSize="12" FontWeight="SemiBold" Text="Companion ready" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="#273240" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="28,24,0,10" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Text="WORKSPACE" />

                <StackPanel Grid.Row="1">
                    <Button x:Name="NavProjectsButton" Tag="Projects" Style="{StaticResource SidebarButtonSelectedStyle}" Click="ShellNavigation_Click" Content="Projects" />
                    <Button x:Name="NavProjectButton" Tag="Project" Style="{StaticResource SidebarButtonStyle}" Click="ShellNavigation_Click" Content="Project" IsEnabled="False" />
                    <Button x:Name="NavAssetsButton" Tag="Assets" Style="{StaticResource SidebarButtonStyle}" Click="ShellNavigation_Click" Content="Assets" />
                    <Button x:Name="NavToolsButton" Tag="Tools" Style="{StaticResource SidebarButtonStyle}" Click="ShellNavigation_Click" Content="Tools" />
                    <Button x:Name="NavSettingsButton" Tag="Settings" Style="{StaticResource SidebarButtonStyle}" Click="ShellNavigation_Click" Content="Settings" />
                </StackPanel>

                <Border Grid.Row="2" Margin="16" Padding="13" Background="#151C25" BorderBrush="#283441" BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Text="CURRENT WORKSPACE" />
                        <TextBlock x:Name="ShellSidebarProjectText" Margin="0,5,0,0" FontWeight="SemiBold" Text="No project" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ShellSidebarGameText" Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="Choose a project to begin" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,20">
            <!-- Projects -->
            <ScrollViewer x:Name="ProjectsView" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Projects" />
                    <TextBlock Margin="0,6,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Text="Create a new mapping workspace or open an existing Companion project." />

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="NEW PROJECT" />
                                <TextBlock Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Text="Start a mapping project" />
                                <TextBlock Margin="0,6,40,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Choose the target game. Companion will create the development workspace and keep runtime files separate." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="ProjectGameComboBox" Width="135" Height="38" Margin="0,0,10,0" SelectedIndex="0">
                                    <ComboBoxItem Tag="dusk" Content="DUSK" />
                                    <ComboBoxItem Tag="quake" Content="Quake" />
                                    <ComboBoxItem Tag="halflife" Content="Half-Life" />
                                </ComboBox>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="ShellNewProject_Click" Content="New Project" />
                                <Button Style="{StaticResource DarkButtonStyle}" Margin="0" Click="ShellOpenProject_Click" Content="Open Project" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="RECENT PROJECTS" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Continue a project" />
                                    <TextBlock Margin="0,5,40,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Text="Recently created or opened Companion projects." />
                                </StackPanel>
                                <Button x:Name="OpenRecentProjectButton"
                                        Grid.Column="1"
                                        MinWidth="92"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DarkButtonStyle}"
                                        IsEnabled="False"
                                        Click="OpenRecentProject_Click"
                                        Content="Open" />
                            </Grid>
                            <TextBlock x:Name="RecentProjectsEmptyText"
                                       Margin="0,16,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="Projects you create or open will appear here." />
                            <ListBox x:Name="RecentProjectsListBox"
                                     Margin="0,12,0,0"
                                     MaxHeight="220"
                                     Visibility="Collapsed"
                                     Style="{StaticResource ProjectMapListStyle}"
                                     ItemContainerStyle="{StaticResource ProjectMapListItemStyle}"
                                     ItemTemplate="{StaticResource RecentProjectChoiceTemplate}"
                                     SelectionChanged="RecentProjectsListBox_SelectionChanged"
                                     MouseDoubleClick="RecentProjectsListBox_MouseDoubleClick" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Text="WORKSPACE MODEL" />
                                <TextBlock Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" Text="Source files stay organized outside the game folder" />
                                <TextBlock Margin="0,7,40,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Maps, WADs, skyboxes, build files, and backups live in the Companion project workspace. Only runtime-required files are deployed to the selected game." />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" Text="→" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Project -->
            <ScrollViewer x:Name="ProjectView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="Bold" Text="Project" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Text="Your active map workspace and project-level locations." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DarkButtonStyle}" Margin="0" VerticalAlignment="Center" Click="ShellCloseProject_Click" Content="Close Project" />
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="PROJECT OVERVIEW" />
                                <TextBlock x:Name="ProjectNameText" Margin="0,5,0,0" FontSize="23" FontWeight="SemiBold" Text="No project open" />
                                <TextBlock x:Name="ProjectDetailsText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="Create or open a project to begin." />
                                <TextBlock x:Name="ProjectLocationText" Margin="0,5,0,0" MaxWidth="720" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="CloseProjectButton" Grid.Column="1" Style="{StaticResource DarkButtonStyle}" Margin="24,0,0,0" VerticalAlignment="Center" IsEnabled="False" Click="ShellCloseProject_Click" Content="Close" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Maps" />
                                    <TextBlock x:Name="MapsHelpText"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="Choose a map to work on, or add another map to this project." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="NewMapButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Foreground="#FFFFFF"
                                            IsEnabled="False"
                                            Click="NewMap_Click"
                                            Content="+ New Map" />
                                    <Button x:Name="ImportMapButton"
                                            Style="{StaticResource DarkButtonStyle}"
                                            Foreground="#FFFFFF"
                                            IsEnabled="False"
                                            Click="ImportMap_Click"
                                            Content="Add Existing" />
                                    <Button x:Name="ProjectUtilitiesButton"
                                            Width="42"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="#FFFFFF"
                                            Click="ProjectUtilities_Click"
                                            Content="⋯"
                                            ToolTip="Project folders">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                                <MenuItem
                                                          Header="Project Files"
                                                          Style="{StaticResource DarkMenuItemStyle}"
                                                          Click="OpenProjectFolder_Click" />
                                                <MenuItem
                                                          Header="Game Folder"
                                                          Style="{StaticResource DarkMenuItemStyle}"
                                                          Click="OpenGameFolder_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    MinHeight="92"
                                    MaxHeight="320"
                                    Background="#111820"
                                    BorderBrush="#2F3D4D"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <ListBox x:Name="ProjectMapListBox"
                                             Style="{StaticResource ProjectMapListStyle}"
                                             ItemContainerStyle="{StaticResource ProjectMapListItemStyle}"
                                             SelectionChanged="ProjectMapListBox_SelectionChanged"
                                             MouseDoubleClick="ProjectMapListBox_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FullPath}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   Text="Select to make current • Double-click to open"
                                                                   IsHitTestVisible="False" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Width="34"
                                                            Height="30"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Foreground="#FFFFFF"
                                                            Content="⋯"
                                                            Tag="{Binding}"
                                                            ToolTip="Map actions"
                                                            Click="ProjectMapOverflow_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="EmptyProjectMapsPanel"
                                                Margin="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="No maps yet."
                                                   TextAlignment="Center" />
                                        <TextBlock Margin="0,6,0,0"
                                                   MaxWidth="520"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Text="Create your first map or add an existing .map file to this project."
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,14,0,0"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button x:Name="EmptyCreateFirstMapButton"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Foreground="#FFFFFF"
                                                    Click="NewMap_Click"
                                                    Content="+ Create First Map" />
                                            <Button x:Name="EmptyAddExistingMapButton"
                                                    Style="{StaticResource DarkButtonStyle}"
                                                    Foreground="#FFFFFF"
                                                    Click="ImportMap_Click"
                                                    Content="Add Existing" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                                                                                    <Border x:Name="ProjectWorkflowPanel" Grid.Row="4"
                                    Padding="14"
                                    Background="#121A24"
                                    BorderBrush="#2F3D4D"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                MaxWidth="410"
                                                VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Text="NEXT STEP" />
                                        <TextBlock x:Name="ProjectNextStepTitleText"
                                                   Margin="0,4,0,0"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="Choose a map" />
                                        <TextBlock x:Name="ProjectNextStepDetailText"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Text="Select a map to continue."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="ManageAssetsButton"
                                                Tag="Assets"
                                                Style="{StaticResource DarkButtonStyle}"
                                                Foreground="#FFFFFF"
                                                Click="ShellNavigation_Click"
                                                Content="Manage Assets" />
                                        <Button x:Name="CompileSettingsButton"
                                                Style="{StaticResource DarkButtonStyle}"
                                                Foreground="#FFFFFF"
                                                IsEnabled="False"
                                                Click="CompileSettings_Click"
                                                Content="Compile Settings" />
                                    </StackPanel>
                                    <Button x:Name="OpenCurrentMapButton"
                                            Grid.Column="3"
                                            MinWidth="205"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Foreground="#FFFFFF"
                                            IsEnabled="False"
                                            Click="OpenCurrentMap_Click"
                                            Content="Open in TrenchBroom" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Assets -->
            <Grid x:Name="AssetsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Assets" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               Text="Browse and manage reusable texture archives shared across Companion projects." />
                </StackPanel>
                <Border Grid.Row="2"
                        Padding="22"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="WAD Library" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Import WADs once, then open any archive to browse its textures visually." />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Margin="24,4,0,4"
                                       VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,10,10"
                                        Click="AddWads_Click"
                                        Content="Import WADs" />
                                <Button x:Name="BrowseWadButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,10,10"
                                        IsEnabled="False"
                                        Click="BrowseSelectedWad_Click"
                                        Content="Browse WAD" />
                                <Button x:Name="WadLibraryMoreButton"
                                        Visibility="Collapsed"
                                        Style="{StaticResource DarkButtonStyle}"
                                        Margin="0,0,10,10"
                                        Click="WadLibraryMoreButton_Click"
                                        Content="More">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                            <MenuItem x:Name="RefreshWadsMenuItem"
                                                      Header="Refresh Library"
                                                      Style="{StaticResource DarkMenuItemStyle}"
                                                      IsEnabled="False"
                                                      Click="RefreshRegistrations_Click" />
                                            <MenuItem x:Name="OpenWadFolderMenuItem"
                                                      Header="Open Folder"
                                                      Style="{StaticResource DarkMenuItemStyle}"
                                                      IsEnabled="False"
                                                      Click="OpenSelectedFolder_Click" />
                                            <Separator />
                                            <MenuItem x:Name="RemoveWadMenuItem"
                                                      Header="Remove from Library"
                                                      Style="{StaticResource DarkMenuItemStyle}"
                                                      IsEnabled="False"
                                                      Click="RemoveSelected_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WadSearchTextBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="WadSearchTextBox_TextChanged"
                                     ToolTip="Search WAD names, paths, formats, manifests, or validation text" />
                            <StackPanel Grid.Column="2"
                                        Margin="2,2,2,2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button x:Name="Wad2LibraryTabButton"
                                        Tag="WAD2"
                                        MinWidth="92"
                                        MinHeight="44"
                                        Margin="0,0,6,0"
                                        Padding="16,9"
                                        BorderThickness="1,1,1,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="WadLibraryFormatTab_Click"
                                        Content="WAD2" />
                                <Button x:Name="Wad3LibraryTabButton"
                                        Tag="WAD3"
                                        MinWidth="92"
                                        MinHeight="44"
                                        Margin="0,0,6,0"
                                        Padding="16,9"
                                        BorderThickness="1,1,1,0"
                                        Style="{StaticResource DarkButtonStyle}"
                                        Click="WadLibraryFormatTab_Click"
                                        Content="WAD3" />
                                <Button x:Name="FindOnlineWadsTabButton"
                                        MinWidth="150"
                                        MinHeight="44"
                                        Margin="0,0,2,0"
                                        Padding="16,7"
                                        BorderThickness="1,1,1,0"
                                        Style="{StaticResource DarkButtonStyle}"
                                        Click="FindOnlineWads_Click">
                                    <TextBlock Margin="2,0"
                                               TextAlignment="Center"
                                               LineHeight="14">
                                        <Run Text="Browse Community" />
                                        <LineBreak />
                                        <Run Text="WADs" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        Margin="4,2,4,2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="WadVisibleCountText"
                                           Margin="0,0,2,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Text="0 shown" />
                                <Button x:Name="RefreshWadsButton"
                                        Width="32"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="RefreshRegistrations_Click"
                                        Content="↻"
                                        ToolTip="Refreshes WAD list" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="4"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <DataGrid x:Name="RegistrationGrid"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding WadLibraryView}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="RegistrationGrid_SelectionChanged"
                                  MouseDoubleClick="RegistrationGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="300" Header="WAD">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="6,0,10,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding WadFileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding WadFileName}" />
                                                <Button Grid.Column="1"
                                                        Focusable="False"
                                                        Click="RemoveWadRow_Click"
                                                        Content="Remove"
                                                        ToolTip="Remove this WAD from the Companion library">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource DarkButtonStyle}">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter Property="Padding"
                                                                    Value="9,3" />
                                                            <Setter Property="MinHeight"
                                                                    Value="26" />
                                                            <Setter Property="Margin"
                                                                    Value="12,0,6,0" />
                                                            <Setter Property="FontSize"
                                                                    Value="11" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="80" Header="Format" Binding="{Binding WadFormat}" />
                                <DataGridTextColumn Width="95" Header="Textures" Binding="{Binding TextureCountText}" />
                                <DataGridTextColumn Width="80" Header="Aliases" Binding="{Binding AliasCountText}" />
                                <DataGridTextColumn Width="250" Header="Status" Binding="{Binding Validation}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyRegistrationPanel"
                                Margin="24"
                                Background="#121922"
                                BorderBrush="#334252"
                                BorderThickness="1"
                                CornerRadius="7"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="EmptyRegistrationTitleText"
                                           HorizontalAlignment="Center"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Text="No WADs in the library yet" />
                                <TextBlock x:Name="EmptyRegistrationDetailText"
                                           Margin="0,8,0,0"
                                           MaxWidth="480"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Drag WAD files or folders here, or use Import WADs." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <!-- Tools -->
            <ScrollViewer x:Name="ToolsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Tools" />
                    <TextBlock Margin="0,6,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Text="Launch the mapping tools that are currently integrated with Companion." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="TEXTURE TOOL" />
                                    <TextBlock Margin="0,6,0,0" FontSize="21" FontWeight="SemiBold" Text="WadForge" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Create and manage WAD archives while preserving friendly texture aliases for the Companion-compatible TrenchBroom build." />
                                </StackPanel>
                                <Button Grid.Row="2" Margin="0,22,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Click="OpenWadForge_Click" Content="Open WadForge" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="LEVEL EDITOR" />
                                    <TextBlock Margin="0,6,0,0" FontSize="21" FontWeight="SemiBold" Text="TrenchBroom" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Launch the Companion-managed TrenchBroom installation without opening a specific map." />
                                </StackPanel>
                                <Button x:Name="LaunchButton" Grid.Row="2" Margin="0,22,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" IsEnabled="False" Click="LaunchTrenchBroom_Click" Content="Launch TrenchBroom" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Settings" />
                    <TextBlock Margin="0,6,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Text="Manage Companion integrations and application-level paths." />

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="TrenchBroom installation" />
                                    <TextBlock x:Name="InstallationStatusText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="No TrenchBroom executable selected." />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DarkButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center" Click="SelectInstallation_Click" Content="Change" />
                            </Grid>
                            <TextBox x:Name="InstallationPathTextBox" Grid.Row="2" IsReadOnly="True" Text="No installation selected" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#10161E" BorderBrush="#273240" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RegistrationCountText" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Text="0 library WADs" />
                <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="Ready." TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
