<Window x:Class="TrenchBroom.Companion.App.CompanionOnlineWadBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find WADs Online"
        Width="1060"
        Height="700"
        MinWidth="1060"
        MinHeight="700"
        MaxWidth="1060"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E1218"
        Foreground="#FFFFFF"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#171E27" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3745" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB9C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#748193" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5EA2FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#111820" />
            <Setter Property="BorderBrush" Value="#364455" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#315F94" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="BrowserButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#26313E" />
            <Setter Property="BorderBrush" Value="#3A4859" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryBrowserButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BrowserButtonStyle}">
            <Setter Property="Background" Value="#2768AE" />
            <Setter Property="BorderBrush" Value="#5EA2FF" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2B3745" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#26313D" />
            <Setter Property="RowBackground" Value="#131A22" />
            <Setter Property="AlternatingRowBackground" Value="#171F29" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202A35" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#344252" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24476D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Text="Find WADs Online" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           Text="Browse supported repositories, preview the real archive, then add it to the global Companion library." />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="90"
                    VerticalAlignment="Top"
                    Style="{StaticResource BrowserButtonStyle}"
                    IsCancel="True"
                    Content="Close" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="SOURCES" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Each website is handled by its own Companion adapter." />
                    </StackPanel>

                    <ListBox x:Name="RepositoryListBox"
                             Grid.Row="2"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="RepositoryListBox_SelectionChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="RepositoryTitleText"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Select a source" />
                        <TextBlock x:Name="RepositoryDescriptionText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="OnlineSearchTextBox"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnlineSearchTextBox_TextChanged"
                                 ToolTip="Search this online WAD source" />

                        <TextBlock x:Name="OnlineCountText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="0 WADs" />
                    </Grid>

                    <DataGrid x:Name="OnlineWadGrid"
                              Grid.Row="4"
                              IsReadOnly="True"
                              SelectionChanged="OnlineWadGrid_SelectionChanged"
                              MouseDoubleClick="OnlineWadGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                MinWidth="260"
                                                Header="WAD"
                                                Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Width="220"
                                                Header="File"
                                                Binding="{Binding FileName}" />
                            <DataGridTextColumn Width="90"
                                                Header="Expected"
                                                Binding="{Binding ExpectedFormat}" />
                            <DataGridTextColumn Width="90"
                                                Header="Palette"
                                                Binding="{Binding PaletteHint}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OnlineStatusText"
                       MaxWidth="560"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11"
                       Text="Select a source to load its catalog."
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="OpenSourceButton"
                        Margin="0,0,8,0"
                        Style="{StaticResource BrowserButtonStyle}"
                        IsEnabled="False"
                        Click="OpenSourceButton_Click"
                        Content="Open Website" />

                <Button x:Name="PreviewOnlineWadButton"
                        Margin="0,0,8,0"
                        Style="{StaticResource BrowserButtonStyle}"
                        IsEnabled="False"
                        Click="PreviewOnlineWadButton_Click"
                        Content="Preview" />

                <Button x:Name="ImportOnlineWadButton"
                        Style="{StaticResource PrimaryBrowserButtonStyle}"
                        IsEnabled="False"
                        Click="ImportOnlineWadButton_Click"
                        Content="Add to Library" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>